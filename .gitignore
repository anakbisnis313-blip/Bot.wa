const { default: makeWASocket, useMultiFileAuthState } = require('@whiskeysockets/baileys');
const readline = require('readline');

const NOMOR_BOT = '628132544099';

async function startBot() {
    const { state, saveCreds } = await useMultiFileAuthState('session-bot-public');
    const sock = makeWASocket({ auth: state, printQRInTerminal: false, browser: ['Bot Auto Chat', 'Chrome', '1.0'] });
    sock.ev.on('creds.update', saveCreds);

    if (!sock.authState.creds.registered) {
        const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
        rl.question('Tekan ENTER untuk minta Kode Tautan...', async () => {
            const code = await sock.requestPairingCode(NOMOR_BOT);
            console.log('KODE TAUTAN: ' + code);
            rl.close();
        });
    }

    sock.ev.on('connection.update', (u) => {
        if (u.connection === 'open') console.log('BOT AUTO CHAT ON ✅');
    });

    sock.ev.on('messages.upsert', async ({ messages }) => {
        const m = messages[0];
        if (!m.message || m.key.fromMe) return;
        const from = m.key.remoteJid;
        const isGroup = from.endsWith('@g.us');
        const text = (m.message.conversation || m.message.extendedTextMessage?.text || m.message.imageMessage?.caption || '').toLowerCase();
        const pushName = m.pushName || 'Kak';

        // JANGAN BALES KALAU DI GRUP TAPI GAK NGETAG BOT / GAK PAKE PERINTAH - biar gak spam
        // Kalau mau bot bales semua chat di grup, hapus 3 baris di bawah ini
        // if (isGroup && !text.startsWith('!') && !text.includes('halo') && !text.includes('bot')) return;

        console.log(`Chat dari ${pushName}: ${text}`);

        // === 1. SAPAAN OTOMATIS ===
        if (text === 'halo' || text === 'hi' || text === 'p' || text === 'assalamualaikum' || text === 'selamat siang' || text === 'selamat malam' || text === 'selamat pagi') {
            await sock.sendMessage(from, { text: `Halo ${pushName}! 👋\nSelamat datang di toko kami!\n\nKetik salah satu:\n*1* - Lihat Katalog\n*2* - Cara Order\n*3* - Cek Harga / Ongkir\n*4* - Buat Stiker (!stiker)\n*5* - Chat Admin` });
            return;
        }

        // === 2. MENU OTOMATIS ===
        if (text === '1' || text === '!menu' || text === 'menu' || text === 'katalog') {
            await sock.sendMessage(from, { text: `*📦 KATALOG KAMI*\n\n1. Produk A - Rp 50.000\n2. Produk B - Rp 75.000\n3. Produk C - Rp 100.000\n\nKetik *2* untuk cara order ya kak!` });
            return;
        }

        if (text === '2' || text === 'order' || text === 'cara order' || text === 'mau order' || text === 'pesan') {
            await sock.sendMessage(from, { text: `*🛒 CARA ORDER*\n\n1. Pilih produknya (ketik 1)\n2. Kirim Nama + Alamat Lengkap\n3. Transfer ke rekening yang kami kirim\n4. Kirim bukti transfer\n\nLangsung ketik aja: *Nama, Alamat, Pesanan*\nContoh: Sinta, Gresik, Produk A 1pcs` });
            return;
        }

        if (text === '3' || text.includes('harga') || text.includes('ongkir') || text.includes('berapa')) {
            await sock.sendMessage(from, { text: `*💰 HARGA & ONGKIR*\n\nHarga mulai Rp 50.000\nOngkir Gresik: Rp 10.000\nOngkir Surabaya: Rp 15.000\nLuar kota cek ongkir ketik: *ongkir + kota*\nContoh: ongkir Jakarta` });
            return;
        }

        if (text === '4' || text.startsWith('!stiker')) {
            await sock.sendMessage(from, { text: `*✨ BUAT STIKER*\nKirim foto + caption *!stiker*\nDi grup: Reply foto temen lu + ketik *!stiker*\n\nCoba sekarang, kirim foto kamu!` });
            return;
        }

        if (text === '5' || text.includes('admin') || text.includes('manusia') || text.includes('cs')) {
            await sock.sendMessage(from, { text: `Siap kak, admin kami akan hubungi kakak sebentar lagi ya 🙏\nMohon tunggu, jam kerja 08.00 - 21.00 WIB` });
            return;
        }

        // === 3. AUTO BALAS KALAU ADA KATA KUNCI ===
        if (text.includes('terima kasih') || text.includes('makasih') || text.includes('thank')) {
            await sock.sendMessage(from, { text: `Sama-sama ${pushName}! 🥰\nTerima kasih udah mampir, jangan lupa order lagi ya!` });
            return;
        }

        if (text.includes('transfer') || text.includes('udah tf') || text.includes('bukti')) {
            await sock.sendMessage(from, { text: `Siap kak! Bukti transfernya kami cek dulu ya ✅\nKalau udah valid, orderan langsung kami proses & kirim resi.` });
            return;
        }

        if (text.includes('kapan sampai') || text.includes('resi') || text.includes('paket')) {
            await sock.sendMessage(from, { text: `Untuk cek resi, kirim nomor resi kakak ya.\nEstimasi pengiriman 2-4 hari kerja.\nPaket OTW! 📦` });
            return;
        }

        if (text.includes('buka') || text.includes('tutup') || text.includes('jam berapa')) {
            await sock.sendMessage(from, { text: `Toko kami buka setiap hari 08.00 - 21.00 WIB kak!\nDi luar jam itu chat tetap dibalas bot, admin bales besok pagi ya.` });
            return;
        }

        // === 4. KALAU CHAT GAK DIKENAL, BALES OTOMATIS BIAR GAK DIDEMIN ===
        // Ini cuma jalan di chat pribadi, bukan grup biar gak spam
        if (!isGroup) {
            await sock.sendMessage(from, { text: `Halo ${pushName}, maaf bot belum paham chat kakak 😅\n\nCoba ketik:\n*1* - Katalog\n*2* - Cara Order\n*3* - Harga\n*4* - Buat Stiker\n*5* - Chat Admin` });
        }
    });
}
startBot();

